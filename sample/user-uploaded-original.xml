    <appendix id="appendix-a">

        <title>
            Technical Appendix
        </title>

        <section id="xml-example">

            <title>
                XML Example
            </title>

            <paragraph>
                The following example demonstrates escaped XML characters.
            </paragraph>

            <code language="xml"><![CDATA[
                <example>
                    <value>
                        x < y && y > z
                    </value>
                </example>
            ]]></code>

        </section>


        <section id="special-characters">

            <title>
                Special Characters
            </title>

            <paragraph>
                XML requires characters such as &lt;, &gt;, and &amp;
                to be represented using escaped entities when they occur
                as ordinary text.
            </paragraph>

            <example
                value="Tom &amp; Jerry"
                expression="x &lt; y"
                comparison="a &gt; b"/>

        </section>


        <section id="deep-nesting">

            <title>
                Deeply Nested Structure
            </title>

            <level-1 id="L1">

                <level-2 id="L2">

                    <level-3 id="L3">

                        <level-4 id="L4">

                            <level-5 id="L5">

                                <level-6 id="L6">

                                    <level-7 id="L7">

                                        <level-8 id="L8">

                                            <value>
                                                Deeply nested XML content
                                            </value>

                                        </level-8>

                                    </level-7>

                                </level-6>

                            </level-5>

                        </level-4>

                    </level-3>

                </level-2>

            </level-1>

        </section>

